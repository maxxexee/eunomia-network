# Supabase project URL and service role key for the faucet edge function.
# The service role key must never be used in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sepolia RPC endpoint used by the faucet.
SEPOLIA_RPC_URL=

# Faucet vault wallet. Fund it with Sepolia ETH for gas and EUN for claims.
VAULT_PRIVATE_KEY=

# EUN ERC20 contract on Sepolia.
EUN_CONTRACT_ADDRESS=

# Set these as Supabase function secrets, not in the browser bundle.
# The frontend Supabase URL and anon key in js/auth.js are public by design.
